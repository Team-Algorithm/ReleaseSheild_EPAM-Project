{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep",
          "version": "1.45.0",
          "informationUri": "https://semgrep.dev",
          "rules": [
            {
              "id": "python.django.security.injection.sql",
              "shortDescription": {
                "text": "User input concatenated directly into raw SQL query"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "javascript.express.security.command-injection",
              "shortDescription": {
                "text": "Unsanitized user payload passed to child_process.exec"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "python.django.security.injection.sql",
